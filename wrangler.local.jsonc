{
  "name": "mailflare-local",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailflare-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mailflare-local-raw"
    }
  ]
}
