# Coolify: Dockerfile build pack, port 3000, persistent volume mounted at /data.
APP_URL=https://mail.trtcrm.com
DATA_DIR=/data
MAIL_ADDRESS=hello@trtmaroc.com
MAIL_DOMAINS=trtmaroc.com
ADMIN_EMAIL=hello@trtmaroc.com
# Set a unique password of at least 16 characters. Only used on first startup.
ADMIN_PASSWORD=

# Your existing provider's SMTP settings. No Cloudflare credentials needed.
SMTP_HOST=mail.trtdigital.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@trtmaroc.com
SMTP_PASSWORD=
SMTP_ALLOWED_FROM=hello@trtmaroc.com

IMAP_HOST=mail.trtdigital.eu
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=hello@trtmaroc.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
MAIL_POLL_INTERVAL_MS=30000
# 0 starts with new arrivals; 50 imports up to the last 50 UIDs on the first sync.
IMAP_INITIAL_LIMIT=0
# Optional allowlist for the manual IMAP import screen (defaults to IMAP_HOST).
IMAP_ALLOWED_HOSTS=
