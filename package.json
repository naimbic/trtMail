{
  "name": "trtmail",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:seed": "curl -X POST http://localhost:3000/api/seed",
    "dev:local": "next dev --hostname 127.0.0.1 --port 3113",
    "server:init": "tsx scripts/server/init.ts",
    "server:worker": "tsx scripts/server/worker.ts",
    "start:coolify": "node scripts/server/start.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:server": "tsx --test scripts/server/runtime.test.ts"
  },
  "license": "SEE LICENSE IN LICENSE",
